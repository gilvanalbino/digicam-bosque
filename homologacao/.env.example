# Copiar para .env (não versionado) e preencher
COMPOSE_PROJECT_NAME=digicam-hml
# commit curto usado como tag das imagens digicam-*:hml-<commit>
HML_TAG=
# gerar cada uma com: openssl rand -hex 16
HML_DB_PASS=
HML_DB_ROOT_PASS=
HML_JWT_KEY=
# senha do usuário digicamftp (SFTP das fotos das câmeras)
SFTP_PASS=
